{
  "name": "react-code-stream",
  "private": true,
  "version": "0.1.0",
  "description": "react-code-stream monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspace=react-code-stream",
    "dev": "npm run dev --workspace=docs",
    "build": "npm run build --workspaces --if-present",
    "build:lib": "npm run build --workspace=react-code-stream",
    "build:docs": "npm run build --workspace=docs"
  }
}
