{
  "name": "react-code-stream",
  "private":"true",
  "version": "0.1.0",
  "description": "react-code-stream monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "npm run dev --workspace=@react-code-stream/docs",
    "build": "npm run build --workspaces --if-present",
    "build:lib": "npm run build --workspace=react-code-stream",
    "build:docs": "npm run build --workspace=@react-code-stream/docs"
  }
}
